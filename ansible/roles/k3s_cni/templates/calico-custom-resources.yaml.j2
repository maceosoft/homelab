# Calico Installation CR — pod CIDR alineado con K3s
apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default
spec:
  calicoNetwork:
    # IP de cada nodo para la red de pods: la InternalIP de Kubernetes (la del cable). Con firstFound Calico puede
    # elegir la IP del WiFi de respaldo, que está en la misma subred (ver gitops: addons/network/calico/custom-resources.yaml).
    nodeAddressAutodetectionV4:
      kubernetes: NodeInternalIP
    ipPools:
      - blockSize: 26
        cidr: {{ k3s_install.core.cluster_cidr }}
        encapsulation: VXLANCrossSubnet
        natOutgoing: Enabled
        nodeSelector: all()
---
apiVersion: operator.tigera.io/v1
kind: APIServer
metadata:
  name: default
