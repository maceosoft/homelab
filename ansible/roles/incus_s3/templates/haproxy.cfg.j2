# {{ ansible_managed }}
# Rol incus_s3: publica el S3 de Incus (buckets del pool {{ incus_s3_pool }}) con un certificado de la CA del HomeLab.
# Modo tcp: termina TLS y vuelve a cifrar hacia Incus sin tocar la petición, así la firma S3 (SigV4, que incluye la
# cabecera Host) llega intacta. Docs: docs/storage/postgres.md
global
    log /dev/log local0
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    user haproxy
    group haproxy
    daemon
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets
    ssl-default-server-options ssl-min-ver TLSv1.2

defaults
    log global
    mode tcp
    option tcplog
    timeout connect 5s
    # Subidas largas (respaldos base y WAL) sin cortes por inactividad corta.
    timeout client 10m
    timeout server 10m

frontend incus_s3
    bind {{ incus_s3_listen_address }}:{{ incus_s3_port }} ssl crt {{ incus_s3_dir }}/tls.pem
    default_backend incus_s3

backend incus_s3
    # Solo loopback. Se verifica el certificado del clúster Incus fijado (incus-backend.crt), no "cualquiera".
    server incus {{ incus_s3_backend_address }} ssl verify required ca-file {{ incus_s3_dir }}/incus-backend.crt
